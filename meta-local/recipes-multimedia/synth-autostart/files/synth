#!/bin/sh
### BEGIN INIT INFO
# Provides:          synth
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: fluidsynth i automatyczne laczenie kontrolerow MIDI
### END INIT INFO

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

CARD=IQaudIODAC
SF2=/usr/share/sounds/sf2/TimGM6mb.sf2
VOLUME=207        # surowa wartosc Digital: 207 = 0 dB, krok 0,5 dB (201 = -3 dB)
GAIN=0.5          # glosnosc glowna fluidsynth (-g); domyslne 0.2 jest za ciche, zbyt duze znieksztalca
PERIOD_SIZE=256   # klatek w jednym okresie bufora ALSA (256 = ok. 5,8 ms przy 44,1 kHz); 64 dawalo XRUN
PERIODS=4         # liczba okresow w buforze (256 x 4 = 1024 klatek = ok. 23 ms opoznienia)
POLYPHONY=64      # limit jednoczesnych glosow; domyslne 256 przeciazalo procesor przy arpeggiatorze
REVERB="-o synth.reverb.room-size=0.95 -o synth.reverb.damp=0.2 -o synth.reverb.width=1 -o
synth.reverb.level=1"   # duza sala; gałka CC 91 reguluje wysylke
CHORUS="-o synth.chorus.nr=4 -o synth.chorus.level=1.5 -o synth.chorus.speed=0.5 -o
synth.chorus.depth=20"         # parzyste nr = rowno L/P; gałka CC 93 reguluje wysylke
CONNECT=/usr/bin/synth-connect
RESPAWN=/usr/bin/respawn
LOG=/var/log/synth.log
CONNECT_LOG=/var/log/synth-connect.log

# Czeka do 30 s, az karta dzwiekowa sie pojawi (I2S wstaje po starcie).
wait_for_card() {
    i=0
    while [ "$i" -lt 30 ]; do
        grep -q "$CARD" /proc/asound/cards && return 0
        sleep 1
        i=$((i + 1))
    done
    return 1
}

case "$1" in
  start)
    echo -n "Starting synth: "
    wait_for_card || { echo "brak karty $CARD"; exit 1; }
    amixer -c "$CARD" sset Digital "$VOLUME" >/dev/null
    # "$RESPAWN" runs fluidsynth/synth-connect in a loop and brings them
    # back up if they die; the PID file holds respawn's PID, so "stop"
    # (SIGTERM) kills the whole branch (respawn has a trap that kills its
    # child and then exits itself).
    start-stop-daemon -S -b -m -p /run/fluidsynth.pid -x "$RESPAWN" -- "$LOG" \
        fluidsynth -s -i -g "$GAIN" -a alsa -m alsa_seq \
        -o audio.alsa.device=plughw:$CARD -o audio.period-size=$PERIOD_SIZE \
        -o audio.periods=$PERIODS -o synth.polyphony=$POLYPHONY $REVERB $CHORUS "$SF2"
    start-stop-daemon -S -b -m -p /run/synth-connect.pid -x "$RESPAWN" -- "$CONNECT_LOG" "$CONNECT"
    echo "done."
    ;;
  stop)
    echo -n "Stopping synth: "
    start-stop-daemon -K -p /run/synth-connect.pid
    start-stop-daemon -K -p /run/fluidsynth.pid
    rm -f /run/synth-connect.pid /run/fluidsynth.pid
    echo "done."
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}" >&2
    exit 1
    ;;
esac

exit 0
