#!/bin/sh
### BEGIN INIT INFO
# Provides:          synth
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: fluidsynth and automatic MIDI controller connection
### END INIT INFO

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Board settings (CARD, MIXER), installed per machine by synth-autostart
. /etc/default/synth

SF2=/usr/share/sounds/sf2/TimGM6mb.sf2
VOLUME=0dB        # mixer level in dB, works with any control (Digital: 207 raw = 0 dB)
GAIN=0.5          # fluidsynth master gain (-g); the default 0.2 is too quiet, too high distorts
PERIOD_SIZE=256   # frames per ALSA buffer period (256 = ~5.8 ms at 44.1 kHz); 64 caused XRUNs
PERIODS=4         # periods per buffer (256 x 4 = 1024 frames = ~23 ms latency)
POLYPHONY=64      # max simultaneous voices; the default 256 overloaded the CPU with the arpeggiator
REVERB="-o synth.reverb.room-size=0.95 -o synth.reverb.damp=0.2 -o synth.reverb.width=1 -o synth.reverb.level=1"   # large hall; knob CC 91 sets the send
CHORUS="-o synth.chorus.nr=4 -o synth.chorus.level=1.5 -o synth.chorus.speed=0.5 -o synth.chorus.depth=20"         # even nr = equal L/R; knob CC 93 sets the send
CONNECT=/usr/bin/synth-connect
RESPAWN=/usr/bin/respawn
LOG=/var/log/synth.log
CONNECT_LOG=/var/log/synth-connect.log

# Wait up to 30 s for the sound card (it can appear late in boot)
wait_for_card() {
    i=0
    while [ "$i" -lt 30 ]; do
        grep -q "$CARD" /proc/asound/cards && return 0
        sleep 1
        i=$((i + 1))
    done
    return 1
}

case "$1" in
  start)
    echo -n "Starting synth: "
    wait_for_card || { echo "no sound card $CARD"; exit 1; }
    amixer -c "$CARD" sset "$MIXER" "$VOLUME" >/dev/null
    # "$RESPAWN" runs fluidsynth/synth-connect in a loop and brings them
    # back up if they die; the PID file holds respawn's PID, so "stop"
    # (SIGTERM) kills the whole branch (respawn has a trap that kills its
    # child and then exits itself).
    start-stop-daemon -S -b -m -p /run/fluidsynth.pid -x "$RESPAWN" -- "$LOG" \
        fluidsynth -s -i -g "$GAIN" -a alsa -m alsa_seq \
        -o audio.alsa.device=plughw:$CARD -o audio.period-size=$PERIOD_SIZE \
        -o audio.periods=$PERIODS -o synth.polyphony=$POLYPHONY $REVERB $CHORUS "$SF2"
    start-stop-daemon -S -b -m -p /run/synth-connect.pid -x "$RESPAWN" -- "$CONNECT_LOG" "$CONNECT"
    echo "done."
    ;;
  stop)
    echo -n "Stopping synth: "
    start-stop-daemon -K -p /run/synth-connect.pid
    start-stop-daemon -K -p /run/fluidsynth.pid
    rm -f /run/synth-connect.pid /run/fluidsynth.pid
    echo "done."
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}" >&2
    exit 1
    ;;
esac

exit 0
