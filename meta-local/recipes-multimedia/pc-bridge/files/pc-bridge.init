#!/bin/sh
### BEGIN INIT INFO
# Provides:          pc-bridge
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: MIDI CC3 -> Program Change bridge for FluidSynth
### END INIT INFO

DAEMON=/usr/bin/pc-bridge
PIDFILE=/var/run/pc-bridge.pid
LOG=/var/log/pc-bridge.log

[ -x "$DAEMON" ] || exit 0

case "$1" in
  start)
    echo "Starting pc-bridge"
    start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- \
      -c "exec $DAEMON >>$LOG 2>&1"
    ;;
  stop)
    echo "Stopping pc-bridge"
    start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
    rm -f "$PIDFILE"
    ;;
  restart)
    "$0" stop; sleep 1; "$0" start
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "pc-bridge running (pid $(cat "$PIDFILE"))"
    else
      echo "pc-bridge not running"; exit 3
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"; exit 1
    ;;
esac
exit 0
